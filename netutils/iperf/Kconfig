config TEST_CMD_IPERF
	bool "TEST CMD iperf"
	default n
	---help---
		Enable the command iperf

if TEST_CMD_IPERF

config TEST_CMD_IPERF_PROGNAME
	string "test cmd iperf program name"
	default "iperf"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config TEST_CMD_IPERF_PRIORITY
	int "test cmd iperf task priority"
	default 100

config TEST_CMD_IPERF_STACKSIZE
	int "test cmd iperf task stack size"
	default DEFAULT_TASK_STACKSIZE

endif #TEST_CMD_IPERF